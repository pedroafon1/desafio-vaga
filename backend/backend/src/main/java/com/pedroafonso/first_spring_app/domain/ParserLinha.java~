package com.pedroafonso.first_spring_app.domain;

import java.time.LocalDateTime;

public class ParserLinha {

    public ResultadoLinha parse(int numeroLinha, String linha) {
        String[] campos = linha.split(";", -1);

        if(campos.length != 4) {
            return ResultadoLinha.erro(numeroLinha, "Esperado 4 campos, mas encontrou " + campos.length);
        }

        String placa = campos[0].trim().toUpperCase();
        if(placa.isEmpty()){
            return ResultadoLinha.erro(numeroLinha, "Placa não pode ser vazia");
        }

        LocalDateTime dataHora;
        try{
            dataHora = LocalDateTime.parse(campos[1].trim());
        } catch(Exception ex){
            return ResultadoLinha.erro(numeroLinha, "Data/hora inválida: " + campos[1]);
        }

        int velocidade;
        try {
            velocidade = Integer.parseInt(campos[2].trim());
        } catch (NumberFormatException e) {
            return ResultadoLinha.erro(numeroLinha, "Velocidade não numérica: " + campos[2]);
        }
        if(velocidade < 0){
            return ResultadoLinha.erro(numeroLinha, "Velocidade negativa: " + velocidade);
        }

        int limite;
        try {
            limite = Integer.parseInt(campos[3].trim());
        } catch (NumberFormatException e) {
            return ResultadoLinha.erro(numeroLinha, "Limite não numérico: " + campos[3]);
        }
        if(limite <= 0){
            return ResultadoLinha.erro(numeroLinha, "Limite deve ser maior que zero: " + limite);
        }

        return ResultadoLinha.ok(new Leitura(placa, dataHora, velocidade, limite));

    }
}
