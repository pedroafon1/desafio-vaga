package com.pedroafonso.first_spring_app.domain;

import org.junit.jupiter.api.Test;

import java.time.LocalDateTime;

import static org.junit.jupiter.api.Assertions.*;

public class ParserLinhaTest {

    private final ParserLinha parser = new ParserLinha();

    @Test
    void linhaInvalidaViraLeitura() {
        ResultadoLinha r = parser.parse(2, "ABC1D23;2026-10-05T08:00:00;72;60");

        assertTrue(r.valida());
        assertEquals("ABC1D23", r.leitura().placa());
        assertEquals(LocalDateTime.of(2026, 10, 5, 8, 0, 0), r.leitura().dataHora());
        assertEquals(72, r.leitura().velocidadeKmh());
        assertEquals(60, r.leitura().limiteKmh());
    }

    @Test
    void velocidadeNegativaEhInvalida() {
        ResultadoLinha r = parser.parse(5, "ABC1D23;2026-10-05T08:00:00;-72;60");

        assertFalse(r.valida());
        assertEquals(5, r.invalida().numeroLinha());
    }

    @Test
    void dataIlegivelEhInvalida() {
        ResultadoLinha r = parser.parse(7, "ABC1D23;ontem;72;60");

        assertFalse(r.valida());
        assertTrue(r.invalida().motivo().contains("Data"));

    }

    @Test
    void campoFaltandoEhInvalido() {
        ResultadoLinha r = parser.parse(7, ";2026-10-05T08:00:00;72;60");

        assertFalse(r.valida());
    }


}
